@model BiDE.ViewModels.StudentProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    var success = TempData["Success"] as string;
}

<div class="page-container-narrow">
    <div class="section-header">
        <p class="section-label">Account</p>
        <h1 class="section-title">My Profile</h1>
    </div>

    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-info">@success</div>
    }

    <form method="post" asp-action="UpdateStudent" asp-controller="Profile" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error" role="alert">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="form-group" style="text-align: center; margin-bottom: 1.5rem;">
            <div style="margin-bottom: 0.75rem;">
                @if (!string.IsNullOrEmpty(Model.CurrentPictureUrl))
                {
                    <img src="@Model.CurrentPictureUrl" alt="Profile Picture" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover;" />
                }
                else
                {
                    <div style="width: 120px; height: 120px; border-radius: 50%; background: #e2e8f0; display: inline-flex; align-items: center; justify-content: center; font-size: 2rem; color: #94a3b8;">
                        @Model.Initials
                    </div>
                }
            </div>
            <label class="form-label" for="sp-picture">Profile Picture</label>
            <input type="file" asp-for="ProfilePicture" id="sp-picture" accept="image/*" class="form-input" />
            <span asp-validation-for="ProfilePicture" class="text-xs text-destructive"></span>
        </div>

        <div class="form-group">
            <label class="form-label" for="sp-email">Email</label>
            <input type="email" id="sp-email" value="@Model.Email" class="form-input form-input-disabled" disabled />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="sp-firstname">First Name *</label>
                <input type="text" asp-for="FirstName" id="sp-firstname" class="form-input" required />
                <span asp-validation-for="FirstName" class="text-xs text-destructive"></span>
            </div>
            <div class="form-group">
                <label class="form-label" for="sp-lastname">Last Name *</label>
                <input type="text" asp-for="LastName" id="sp-lastname" class="form-input" required />
                <span asp-validation-for="LastName" class="text-xs text-destructive"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="sp-contact">Phone *</label>
            <input type="tel" asp-for="Contact" id="sp-contact" class="form-input" required />
            <span asp-validation-for="Contact" class="text-xs text-destructive"></span>
        </div>

        <div class="form-group">
            <label class="form-label" for="sp-suburb">Suburb / Area</label>
            <input type="text" asp-for="Suburb" id="sp-suburb" class="form-input" placeholder="e.g. Johannesburg North" />
            <span asp-validation-for="Suburb" class="text-xs text-destructive"></span>
        </div>

        <button type="submit" class="btn btn-primary">Update Profile</button>
    </form>
</div>
