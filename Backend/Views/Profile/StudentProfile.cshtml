@model Student
@{
    ViewData["Title"] = "My Profile";
    var success = TempData["Success"] as string;
}

<div class="page-container-narrow">
    <div class="section-header">
        <p class="section-label">Account</p>
        <h1 class="section-title">My Profile</h1>
    </div>

    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-info">@success</div>
    }

    <form method="post" asp-action="UpdateStudent" asp-controller="Profile" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="form-group" style="text-align: center; margin-bottom: 1.5rem;">
            <div style="margin-bottom: 0.75rem;">
                @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                {
                    <img src="@Model.ProfilePicture" alt="Profile Picture" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover;" />
                }
                else
                {
                    <div style="width: 120px; height: 120px; border-radius: 50%; background: #e2e8f0; display: inline-flex; align-items: center; justify-content: center; font-size: 2rem; color: #94a3b8;">
                        @Model.FirstName[0]@Model.LastName[0]
                    </div>
                }
            </div>
            <label class="form-label">Profile Picture</label>
            <input type="file" name="profilePicture" accept="image/*" class="form-input" />
        </div>

        <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" value="@Model.Email" class="form-input form-input-disabled" disabled />
        </div>

        <div class="form-group">
            <label class="form-label">Role</label>
            <input type="text" value="Student" class="form-input form-input-disabled font-mono" disabled />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">First Name *</label>
                <input type="text" name="firstName" value="@Model.FirstName" class="form-input" required />
            </div>
            <div class="form-group">
                <label class="form-label">Last Name *</label>
                <input type="text" name="lastName" value="@Model.LastName" class="form-input" required />
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Phone *</label>
            <input type="tel" name="contact" value="@Model.Contact" class="form-input" required />
        </div>

        <div class="form-group">
            <label class="form-label">Suburb / Area</label>
            <input type="text" name="suburb" value="@Model.Suburb" class="form-input" placeholder="e.g. Johannesburg North" />
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
    </form>
</div>
