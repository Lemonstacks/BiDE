@model Admin
@{
    ViewData["Title"] = "Admin Profile";
}

<div class="page-container-narrow">
    <div class="section-header">
        <p class="section-label">Admin</p>
        <h1 class="section-title">Admin Profile</h1>
    </div>

    <div class="form-group">
        <label class="form-label">Name</label>
        <input type="text" value="@Model.FirstName @Model.LastName" class="form-input form-input-disabled" disabled />
    </div>

    <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" value="@Model.Email" class="form-input form-input-disabled" disabled />
    </div>

    <div class="form-group">
        <label class="form-label">Phone</label>
        <input type="tel" value="@Model.Contact" class="form-input form-input-disabled" disabled />
    </div>

    <div class="form-group">
        <label class="form-label">Role</label>
        <input type="text" value="Administrator" class="form-input form-input-disabled font-mono" disabled />
    </div>

    <a href="/Admin" class="btn btn-primary" style="margin-top: 1rem;">Go to Admin Panel</a>
</div>
