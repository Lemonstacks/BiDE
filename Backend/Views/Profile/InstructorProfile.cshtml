@model BiDE.ViewModels.InstructorProfileViewModel
@{
    ViewData["Title"] = "Instructor Profile";
    var success = TempData["Success"] as string;
}

<div class="page-container-narrow">
    <div class="section-header">
        <p class="section-label">Instructor</p>
        <h1 class="section-title">Instructor Profile</h1>
    </div>

    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-info">@success</div>
    }

    <!-- Application Status -->
    <div class="card" style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div>
            <p class="detail-section-title" style="margin-bottom: 0.5rem;">Application Status</p>
            <span class="badge badge-@Model.Status.ToString().ToLower()">@Model.Status</span>
            @if (Model.Status == InstructorStatus.Pending)
            {
                <p class="text-sm text-muted mt-2">Your profile is under review by our admin team.</p>
            }
            else if (Model.Status == InstructorStatus.Rejected)
            {
                <p class="text-sm text-muted mt-2">Your application was not approved. You may update your profile and resubmit.</p>
                @if (!string.IsNullOrEmpty(Model.RejectionReason))
                {
                    <p class="text-sm text-destructive mt-1">Reason: @Model.RejectionReason</p>
                }
            }
            else if (Model.Status == InstructorStatus.Approved)
            {
                <p class="text-sm text-muted mt-2">You are an approved instructor. Students can find and book you.</p>
            }
        </div>
        <form method="post" asp-action="DeleteInstructorProfile" asp-controller="Profile"
              onsubmit="return confirm('Are you sure you want to delete your instructor profile? This cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-destructive btn-sm">Delete Profile</button>
        </form>
    </div>

    <!-- Profile Form -->
    <form method="post" asp-action="UpdateInstructor" asp-controller="Profile" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error" role="alert">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="form-group" style="text-align: center; margin-bottom: 1.5rem;">
            <div style="margin-bottom: 0.75rem;">
                @if (!string.IsNullOrEmpty(Model.CurrentPictureUrl))
                {
                    <img src="@Model.CurrentPictureUrl" alt="Profile Picture" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover;" />
                }
                else
                {
                    <div style="width: 120px; height: 120px; border-radius: 50%; background: #e2e8f0; display: inline-flex; align-items: center; justify-content: center; font-size: 2rem; color: #94a3b8;">
                        @Model.Initials
                    </div>
                }
            </div>
            <label class="form-label" for="ip-picture">Profile Picture</label>
            <input type="file" asp-for="ProfilePicture" id="ip-picture" accept="image/*" class="form-input" />
            <span asp-validation-for="ProfilePicture" class="text-xs text-destructive"></span>
        </div>

        <div class="form-group">
            <label class="form-label" for="ip-email">Email</label>
            <input type="email" id="ip-email" value="@Model.Email" class="form-input form-input-disabled" disabled />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="ip-firstname">First Name *</label>
                <input type="text" asp-for="FirstName" id="ip-firstname" class="form-input" required />
                <span asp-validation-for="FirstName" class="text-xs text-destructive"></span>
            </div>
            <div class="form-group">
                <label class="form-label" for="ip-lastname">Last Name *</label>
                <input type="text" asp-for="LastName" id="ip-lastname" class="form-input" required />
                <span asp-validation-for="LastName" class="text-xs text-destructive"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="ip-contact">Phone *</label>
            <input type="tel" asp-for="Contact" id="ip-contact" class="form-input" required />
            <span asp-validation-for="Contact" class="text-xs text-destructive"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label" for="ip-suburb">Suburb / Area</label>
                <input type="text" asp-for="Suburb" id="ip-suburb" class="form-input" placeholder="e.g. Johannesburg North" />
                <span asp-validation-for="Suburb" class="text-xs text-destructive"></span>
            </div>
            <div class="form-group">
                <label class="form-label" for="ip-experience">Years of Experience</label>
                <input type="number" id="ip-experience" value="@Model.Experience" class="form-input" disabled readonly style="opacity:0.7;cursor:not-allowed;" />
                <p class="text-xs text-muted" style="margin-top:0.35rem;">Set by an administrator. Contact support to update your verified experience.</p>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="ip-certification">Certification / License</label>
            <input type="text" asp-for="Certification" id="ip-certification" class="form-input" placeholder="Your official certification" />
            <span asp-validation-for="Certification" class="text-xs text-destructive"></span>
        </div>

        <button type="submit" class="btn btn-primary">Update Profile</button>
    </form>

    <!-- Link to manage offerings -->
    @if (Model.Status == InstructorStatus.Approved)
    {
        <div class="card" style="margin-top: 2rem; padding: 1.25rem;">
            <p class="text-sm font-bold">Manage your instructor resources</p>
            <div style="display: flex; gap: 1rem; margin-top: 0.75rem; flex-wrap: wrap;">
                <a href="/InstructorDashboard/Offerings" class="btn btn-sm">Lesson Offerings</a>
                <a href="/InstructorDashboard/Availability" class="btn btn-sm">Availability</a>
                <a href="/InstructorDashboard" class="btn btn-sm">Dashboard</a>
            </div>
        </div>
    }
</div>
