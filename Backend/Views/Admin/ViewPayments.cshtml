@model List<Payment>
@{
    ViewData["Title"] = "View Payments";
    var statusFilter = ViewBag.StatusFilter as string ?? "all";
    var searchFilter = ViewBag.SearchFilter as string ?? "";
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var success = TempData["Success"] as string;
}

<div class="page-container">
    <div class="section-header">
        <p class="section-label">Admin</p>
        <h1 class="section-title">Payments</h1>
    </div>

    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-success">@success</div>
    }

    <!-- Filters -->
    <form method="get" class="filter-bar">
        <div class="form-group flex-1">
            <label class="form-label" for="vp-search">Search</label>
            <input type="text" name="search" id="vp-search" value="@searchFilter"
                   class="form-input" placeholder="Search by student or instructor name..." />
        </div>
        <div class="form-group">
            <label class="form-label" for="vp-status">Status</label>
            <select name="status" id="vp-status" class="form-select">
                <option value="all" selected="@(statusFilter == "all")">All Statuses</option>
                <option value="Pending" selected="@(statusFilter == "Pending")">Pending</option>
                <option value="Verified" selected="@(statusFilter == "Verified")">Verified</option>
                <option value="Rejected" selected="@(statusFilter == "Rejected")">Rejected</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label" for="vp-from">From</label>
            <input type="date" name="dateFrom" id="vp-from" value="@(dateFrom?.ToString("yyyy-MM-dd") ?? "")" class="form-input" />
        </div>
        <div class="form-group">
            <label class="form-label" for="vp-to">To</label>
            <input type="date" name="dateTo" id="vp-to" value="@(dateTo?.ToString("yyyy-MM-dd") ?? "")" class="form-input" />
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-primary btn-sm" style="margin-top: 1.25rem;">Filter</button>
        </div>
        <div class="form-group">
            <a href="@Url.Action("ExportPayments", new { status = statusFilter, search = searchFilter, dateFrom = dateFrom?.ToString("yyyy-MM-dd"), dateTo = dateTo?.ToString("yyyy-MM-dd") })"
               class="btn btn-sm" style="margin-top: 1.25rem;">Export CSV</a>
        </div>
    </form>

    <!-- Summary Stats -->
    <div class="grid-4" style="border: 1px solid var(--border); margin-bottom: 2rem;">
        <div class="stat-card">
            <p class="stat-value">@Model.Count</p>
            <p class="stat-label">Total Payments</p>
        </div>
        <div class="stat-card">
            <p class="stat-value">@Model.Count(p => p.PaymentStatus == "Pending")</p>
            <p class="stat-label">Awaiting Verification</p>
        </div>
        <div class="stat-card">
            <p class="stat-value">R@(Model.Where(p => p.PaymentStatus == "Verified").Sum(p => p.Amount).ToString("N0"))</p>
            <p class="stat-label">Verified Revenue</p>
        </div>
        <div class="stat-card">
            <p class="stat-value">R@(Model.Where(p => p.PaymentStatus == "Pending").Sum(p => p.Amount).ToString("N0"))</p>
            <p class="stat-label">Pending Revenue</p>
        </div>
    </div>

    <!-- Earnings per instructor (verified payments only) -->
    @{
        var earnings = ViewBag.Earnings as List<BiDE.Controllers.AdminController.InstructorEarningsRow> ?? new List<BiDE.Controllers.AdminController.InstructorEarningsRow>();
        var earningsTotal = earnings.Sum(e => e.TotalEarned);
    }
    <div class="section-gap">
        <p class="detail-section-title">Earnings by Instructor</p>
        <hr class="detail-divider" />
        <p class="text-sm text-muted" style="margin-bottom:1rem;">Verified payments only, matching the current filters.</p>
        @if (earnings.Count == 0)
        {
            <div class="empty-state"><p>No verified earnings yet</p><p class="sub">Totals appear here once payments are verified.</p></div>
        }
        else
        {
            <div class="card" style="padding:0;overflow:hidden;">
                <table class="earnings-table">
                    <thead>
                        <tr>
                            <th scope="col">Instructor</th>
                            <th scope="col" style="text-align:center;">Lessons paid</th>
                            <th scope="col" style="text-align:right;">Total earned</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in earnings)
                        {
                            <tr>
                                <td>
                                    <a href="/Instructors/Detail/@e.InstructorId" style="color:var(--primary);font-weight:600;">@e.InstructorName</a>
                                </td>
                                <td style="text-align:center;">@e.LessonsPaid</td>
                                <td style="text-align:right;font-weight:700;">R@(e.TotalEarned.ToString("N0"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td style="font-weight:700;">All instructors</td>
                            <td style="text-align:center;font-weight:700;">@earnings.Sum(e => e.LessonsPaid)</td>
                            <td style="text-align:right;font-weight:800;">R@(earningsTotal.ToString("N0"))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>

    <!-- Payment List -->
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p>No payments found</p>
            <p class="sub">Try adjusting your filters</p>
        </div>
    }
    else
    {
        @foreach (var p in Model)
        {
            <div class="card">
                <div class="card-row">
                    <div>
                        <p class="card-title">@p.Booking?.Student?.FirstName @p.Booking?.Student?.LastName</p>
                        <p class="card-subtitle">
                            Instructor: @p.Booking?.Instructor?.FirstName @p.Booking?.Instructor?.LastName
                            | @(p.Booking?.LessonOffering?.Title ?? "Lesson")
                        </p>
                        <div class="card-meta">
                            <span class="card-meta-item">R@(p.Amount.ToString("N0"))</span>
                            <span class="card-meta-item">@(p.PaymentMethod ?? "N/A")</span>
                            @if (!string.IsNullOrEmpty(p.PaymentReference))
                            {
                                <span class="card-meta-item">Ref: <strong>@p.PaymentReference</strong></span>
                            }
                            <span class="card-meta-item">@(p.PaymentDate?.ToString("MMM d, yyyy") ?? "N/A")</span>
                            @if (!string.IsNullOrEmpty(p.ProofOfPayment))
                            {
                                <span class="card-meta-item">
                                    <a href="@Url.Action("Proof", "Payment", new { id = p.PaymentId })" target="_blank" rel="noopener" aria-label="View proof of payment in a new tab" style="color: var(--primary); text-decoration: underline;">View Proof</a>
                                </span>
                            }
                        </div>
                        @if (p.PaymentStatus == "Rejected" && !string.IsNullOrEmpty(p.RejectionReason))
                        {
                            <p class="text-xs text-destructive mt-1">Rejected: @p.RejectionReason</p>
                        }
                    </div>
                    <div>
                        <span class="badge badge-@p.PaymentStatus?.ToLower()">@p.PaymentStatus</span>
                    </div>
                </div>
            </div>
        }
    }
</div>
