@model List<Availability>
@{
    ViewData["Title"] = "Manage Availability";
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}

<div class="page-container" style="max-width: 800px;">
    <div class="section-header">
        <p class="section-label">Instructor</p>
        <h1 class="section-title">Manage Availability</h1>
    </div>

    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-info">@success</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-error">@error</div>
    }

    <!-- Add New Slot -->
    <form method="post" asp-action="AddAvailability" class="card" style="padding: 1.5rem; margin-bottom: 2.5rem;" onsubmit="return validateSlot()">
        @Html.AntiForgeryToken()
        <p class="detail-section-title" style="margin-bottom: 1rem;">Add Availability Slot</p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
            <div class="form-group" style="flex: 1; min-width: 160px; margin-bottom: 0;">
                <label class="form-label">Date</label>
                <input type="date" name="date" id="slot-date" class="form-input" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-group" style="min-width: 130px; margin-bottom: 0;">
                <label class="form-label">Start Time</label>
                <input type="time" name="startTime" id="slot-start" value="09:00" class="form-input" required />
            </div>
            <div class="form-group" style="min-width: 130px; margin-bottom: 0;">
                <label class="form-label">End Time</label>
                <input type="time" name="endTime" id="slot-end" value="17:00" class="form-input" required />
            </div>
            <button type="submit" class="btn btn-primary">
                + Add
            </button>
        </div>
    </form>

    <!-- Existing Slots -->
    @if (Model.Count == 0)
    {
        <div class="empty-state" style="padding: 3rem;">
            <p class="text-muted">No availability slots set yet.</p>
        </div>
    }
    else
    {
        @foreach (var s in Model)
        {
            var isPast = (s.Date.Date + s.EndTime) < DateTime.Now;

            <div class="card" style="@(isPast ? "opacity: 0.4; pointer-events: none;" : "")">
                <div class="card-row">
                    <div style="display: flex; align-items: center; gap: 1.5rem;">
                        <span class="font-mono text-xs" style="text-transform: uppercase; letter-spacing: 0.1em; width: 120px;">
                            @s.Date.ToString("ddd, MMM d")
                        </span>
                        <span style="font-size: 0.875rem; font-weight: 500;">
                            @s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")
                        </span>
                        @if (isPast)
                        {
                            <span class="badge" style="background: rgba(255,255,255,0.1); color: #999;">Passed</span>
                        }
                        else
                        {
                            <span class="badge badge-@(s.AvailabilityStatus == "Available" ? "approved" : "pending")">
                                @s.AvailabilityStatus
                            </span>
                        }
                    </div>
                    @if (s.AvailabilityStatus == "Available" && !isPast)
                    {
                        <form method="post" asp-action="DeleteAvailability">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.AvailabilityId" />
                            <button type="submit" class="btn btn-icon btn-destructive" title="Remove">
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
<script>
function validateSlot() {
    var dateVal = document.getElementById('slot-date').value;
    var startVal = document.getElementById('slot-start').value;
    var endVal = document.getElementById('slot-end').value;

    if (!dateVal || !startVal || !endVal) return true;

    var now = new Date();
    var slotStart = new Date(dateVal + 'T' + startVal);

    if (slotStart <= now) {
        alert('Cannot add a slot in the past. Please pick a future date and time.');
        return false;
    }

    if (endVal <= startVal) {
        alert('End time must be after start time.');
        return false;
    }

    return true;
}
</script>
}
