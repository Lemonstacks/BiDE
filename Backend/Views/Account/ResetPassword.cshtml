@model BiDE.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="page-header-bg bg-login auth-shell">
    <div class="auth-shell-inner">
        <div class="section-header text-center">
            <span class="section-label">Account Recovery</span>
            <h1 class="section-title">Verify &amp; Reset</h1>
            <p class="section-subtitle" style="margin-left:auto;margin-right:auto;">Answer your security question and set a new password.</p>
        </div>

        <div class="glass-card" style="margin-top:2rem;padding:2rem;">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error" role="alert">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form method="post" asp-action="ResetPassword" asp-controller="Account">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />

                <div class="form-group">
                    <label class="form-label" for="rp-question">Security Question</label>
                    <input type="text" id="rp-question" value="@Model.Question" class="form-input" disabled style="opacity:0.8;" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="rp-answer">Your Answer</label>
                    <input type="text" asp-for="Answer" id="rp-answer" class="form-input" placeholder="Enter your answer" required autocomplete="off" />
                    <span asp-validation-for="Answer" class="text-xs text-destructive"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="rp-new-password">New Password</label>
                    <input type="password" asp-for="NewPassword" id="rp-new-password" class="form-input" placeholder="Min 6 characters" required minlength="6" />
                    <span asp-validation-for="NewPassword" class="text-xs text-destructive"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" for="rp-confirm-password">Confirm New Password</label>
                    <input type="password" asp-for="ConfirmPassword" id="rp-confirm-password" class="form-input" placeholder="Repeat new password" required minlength="6" />
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-destructive"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:0.5rem;">Reset Password</button>
            </form>

            <p style="text-align:center;margin-top:1.5rem;font-size:0.875rem;color:var(--fg-muted);">
                <a href="/Account/Login" style="color:var(--primary);font-weight:600;">Back to login</a>
            </p>
        </div>
    </div>
</div>
