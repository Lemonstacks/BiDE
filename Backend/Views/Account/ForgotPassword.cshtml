@{
    ViewData["Title"] = "Forgot Password";
    var error = ViewBag.Error as string;
    var email = ViewBag.Email as string ?? "";
}

<div class="page-header-bg bg-login auth-shell">
    <div class="auth-shell-inner">
        <div class="section-header text-center">
            <span class="section-label">Account Recovery</span>
            <h1 class="section-title">Forgot Your Password?</h1>
            <p class="section-subtitle" style="margin-left:auto;margin-right:auto;">Enter your email and we'll ask your security question to verify it's you.</p>
        </div>

        <div class="glass-card" style="margin-top:2rem;padding:2rem;">
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-error">@error</div>
            }

            <form method="post" asp-action="ForgotPassword" asp-controller="Account">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label" for="fp-email">Email Address</label>
                    <input type="email" id="fp-email" name="email" value="@email" class="form-input" placeholder="you@example.com" required />
                </div>

                <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:0.5rem;">Continue</button>
            </form>

            <p style="text-align:center;margin-top:1.5rem;font-size:0.875rem;color:var(--fg-muted);">
                Remembered it?
                <a href="/Account/Login" style="color:var(--primary);font-weight:600;">Back to login</a>
            </p>
        </div>
    </div>
</div>
