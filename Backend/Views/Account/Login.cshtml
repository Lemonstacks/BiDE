@{
    ViewData["Title"] = "Login";
    var error = ViewBag.Error as string;
    var email = ViewBag.Email as string ?? "";
    var redirect = ViewBag.Redirect as string ?? "";
}

<div class="page-header-bg bg-login" style="min-height:100vh;display:flex;align-items:center;justify-content:center;">
    <div style="width:100%;max-width:560px;padding:0 1.5rem;">
        <div class="section-header text-center">
            <span class="section-label">Welcome Back</span>
            <h1 class="section-title">Sign In to BiDE</h1>
            <p class="section-subtitle" style="margin-left:auto;margin-right:auto;">Access your account to book lessons, track progress and more.</p>
        </div>

        <div class="glass-card" style="margin-top:2rem;padding:2rem;">
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-error">@error</div>
            }

            <form method="post" asp-action="Login" asp-controller="Account">
                @Html.AntiForgeryToken()
                <input type="hidden" name="redirect" value="@redirect" />

                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="email" value="@email" class="form-input" placeholder="you@example.com" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-input" placeholder="Enter your password" required />
                </div>

                <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:0.5rem;">Sign In</button>
            </form>

            <p style="text-align:center;margin-top:1.5rem;font-size:0.875rem;color:var(--fg-muted);">
                Don't have an account?
                <a href="/Account/Register" style="color:var(--primary);font-weight:600;">Sign up</a>
            </p>
        </div>
    </div>
</div>
