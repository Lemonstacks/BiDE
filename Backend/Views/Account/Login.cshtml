@{
    ViewData["Title"] = "Login";
    var error = ViewBag.Error as string;
    var email = ViewBag.Email as string ?? "";
    var redirect = ViewBag.Redirect as string ?? "";
    var success = TempData["Success"] as string;
}

<div class="page-header-bg bg-login auth-shell">
    <div class="auth-shell-inner">
        <div class="section-header text-center">
            <span class="section-label">Welcome Back</span>
            <h1 class="section-title">Sign In to BiDE</h1>
            <p class="section-subtitle" style="margin-left:auto;margin-right:auto;">Access your account to book lessons, track progress and more.</p>
        </div>

        <div class="glass-card" style="margin-top:2rem;padding:2rem;">
            @if (!string.IsNullOrEmpty(success))
            {
                <div class="alert alert-success">@success</div>
            }
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-error">@error</div>
            }

            <form method="post" asp-action="Login" asp-controller="Account">
                @Html.AntiForgeryToken()
                <input type="hidden" name="redirect" value="@redirect" />

                <div class="form-group">
                    <label class="form-label" for="login-email">Email Address</label>
                    <input type="email" id="login-email" name="email" value="@email" class="form-input" placeholder="you@example.com" required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="login-password">Password</label>
                    <input type="password" id="login-password" name="password" class="form-input" placeholder="Enter your password" required />
                </div>

                <div style="text-align:right;margin-bottom:1rem;">
                    <a href="/Account/ForgotPassword" style="color:var(--primary);font-weight:600;font-size:0.8125rem;">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-primary btn-full btn-lg">Sign In</button>
            </form>

            <p style="text-align:center;margin-top:1.5rem;font-size:0.875rem;color:var(--fg-muted);">
                Don't have an account?
                <a href="/Account/Register" style="color:var(--primary);font-weight:600;">Sign up</a>
            </p>
        </div>
    </div>
</div>
