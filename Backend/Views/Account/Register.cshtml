@{
    ViewData["Title"] = "Register";
    var error = ViewBag.Error as string;
    var vFirstName = ViewBag.FirstName as string ?? "";
    var vLastName = ViewBag.LastName as string ?? "";
    var vEmail = ViewBag.Email as string ?? "";
    var vContact = ViewBag.Contact as string ?? "";
    var vSuburb = ViewBag.Suburb as string ?? "";
    var vRole = ViewBag.Role as string ?? "";
    var vSecurityQuestion = ViewBag.SecurityQuestion as string ?? "";
    var securityQuestions = new[] {
        "What was the name of your first pet?",
        "What city were you born in?",
        "What is your mother's maiden name?",
        "What was the name of your first school?",
        "What is your favourite food?"
    };
}

<div class="page-header-bg bg-register auth-shell" style="align-items:flex-start;">
    <div class="auth-shell-inner">
        <div class="section-header text-center">
            <span class="section-label">Get Started</span>
            <h1 class="section-title">Create Your Account</h1>
            <p class="section-subtitle" style="margin-left:auto;margin-right:auto;">Join BiDE today as a student or instructor.</p>
    </div>

    <div class="glass-card" style="margin-top:2rem;padding:2rem;">
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-error">@error</div>
        }

        <form method="post" asp-action="Register" asp-controller="Account">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label" for="reg-role">I want to register as</label>
                <select id="reg-role" name="role" class="form-select" required>
                    <option value="">-- Select Role --</option>
                    <option value="Student" selected="@(vRole == "Student")">Student (I want to learn to drive)</option>
                    <option value="Instructor" selected="@(vRole == "Instructor")">Instructor (I want to teach)</option>
                </select>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="reg-firstname">First Name *</label>
                    <input type="text" id="reg-firstname" name="firstName" value="@vFirstName" class="form-input" placeholder="First name" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="reg-lastname">Last Name *</label>
                    <input type="text" id="reg-lastname" name="lastName" value="@vLastName" class="form-input" placeholder="Last name" required />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="reg-email">Email Address *</label>
                <input type="email" id="reg-email" name="email" value="@vEmail" class="form-input" placeholder="you@example.com" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="reg-contact">Phone Number *</label>
                <input type="tel" id="reg-contact" name="contact" value="@vContact" class="form-input" placeholder="e.g. 0812345678" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="reg-suburb">Suburb / Area</label>
                <input type="text" id="reg-suburb" name="suburb" value="@vSuburb" class="form-input" placeholder="e.g. Johannesburg North" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" for="reg-password">Password *</label>
                    <input type="password" id="reg-password" name="password" class="form-input" placeholder="Min 6 characters" required minlength="6" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="reg-confirm-password">Confirm Password *</label>
                    <input type="password" id="reg-confirm-password" name="confirmPassword" class="form-input" placeholder="Repeat password" required minlength="6" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="reg-security-question">Security Question *</label>
                <select id="reg-security-question" name="securityQuestion" class="form-select" required>
                    <option value="">-- Select a question --</option>
                    @foreach (var q in securityQuestions)
                    {
                        <option value="@q" selected="@(vSecurityQuestion == q)">@q</option>
                    }
                </select>
                <p class="text-xs text-muted" style="margin-top:0.35rem;">Used to recover your account if you forget your password.</p>
            </div>

            <div class="form-group">
                <label class="form-label" for="reg-security-answer">Security Answer *</label>
                <input type="text" id="reg-security-answer" name="securityAnswer" class="form-input" placeholder="Your answer" required autocomplete="off" />
            </div>

            <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:0.5rem;">Create Account</button>
        </form>

        <p style="text-align:center;margin-top:1.5rem;font-size:0.875rem;color:var(--fg-muted);">
            Already have an account?
            <a href="/Account/Login" style="color:var(--primary);font-weight:600;">Sign in</a>
        </p>
    </div>
</div>
