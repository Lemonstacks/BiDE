@{
    ViewData["Title"] = "Home";
    var instructors = ViewBag.TopInstructors as List<Instructor>;
    int totalInstructors = ViewBag.TotalInstructors;
    int totalBookings = ViewBag.TotalBookings;
    int totalStudents = ViewBag.TotalStudents;
}

<!-- Hero Section -->
<section class="hero">
    <h1 class="hero-title">Learn to Drive<br/>with Confidence</h1>
    <p class="hero-subtitle">
        Connect with verified, professional driving instructors in your area.
        Book lessons, track your progress, and get on the road.
    </p>
    <div class="hero-actions">
        <a href="/Instructors" class="btn btn-primary">Find an Instructor</a>
        <a href="/Account/Register" class="btn">Become an Instructor</a>
    </div>
</section>


<!-- Stats Section -->
<section style="padding: 0 2rem 4rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
        <div class="grid-4" style="border: 1px solid var(--border);">
            <div class="stat-card">
                <svg class="stat-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <p class="stat-value">@totalInstructors</p>
                <p class="stat-label">Verified Instructors</p>
            </div>
            <div class="stat-card">
                <svg class="stat-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <p class="stat-value">@totalBookings</p>
                <p class="stat-label">Lessons Booked</p>
            </div>
            <div class="stat-card">
                <svg class="stat-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/></svg>
                <p class="stat-value">@totalStudents</p>
                <p class="stat-label">Students Registered</p>
            </div>
            <div class="stat-card">
                <svg class="stat-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <p class="stat-value">5.0</p>
                <p class="stat-label">Average Rating</p>
            </div>
        </div>
    </div>
</section>

<!-- How It Works -->
<section style="padding: 4rem 2rem; background: var(--bg-muted);">
    <div style="max-width: 1200px; margin: 0 auto;">
        <div class="section-header text-center">
            <p class="section-label">How It Works</p>
            <h2 class="section-title">Three Simple Steps</h2>
        </div>
        <div class="grid-3" style="margin-top: 2.5rem;">
            <div class="card text-center" style="padding: 2rem;">
                <div style="font-size: 2rem; margin-bottom: 1rem;">1</div>
                <h3 style="font-weight: 600; margin-bottom: 0.5rem;">Browse Instructors</h3>
                <p class="text-sm text-muted">Search by location, specialization, or rating to find your perfect match.</p>
            </div>
            <div class="card text-center" style="padding: 2rem;">
                <div style="font-size: 2rem; margin-bottom: 1rem;">2</div>
                <h3 style="font-weight: 600; margin-bottom: 0.5rem;">Book a Lesson</h3>
                <p class="text-sm text-muted">Choose a time slot that works for you and book instantly.</p>
            </div>
            <div class="card text-center" style="padding: 2rem;">
                <div style="font-size: 2rem; margin-bottom: 1rem;">3</div>
                <h3 style="font-weight: 600; margin-bottom: 0.5rem;">Start Driving</h3>
                <p class="text-sm text-muted">Meet your instructor, learn at your pace, and track your progress.</p>
            </div>
        </div>
    </div>
</section>


<!-- Featured Instructors -->
@if (instructors != null && instructors.Count > 0)
{
<section style="padding: 4rem 2rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
        <div class="section-header">
            <p class="section-label">Featured</p>
            <h2 class="section-title">Top Instructors</h2>
        </div>
        <div class="grid-3" style="margin-top: 1.5rem;">
            @foreach (var i in instructors)
            {
                <a href="/Instructors/Detail/@i.InstructorId" class="instructor-card">
                    <div class="instructor-card-img">
                        @i.FirstName[0]@i.LastName[0]
                    </div>
                    <div class="instructor-card-body">
                        <p class="instructor-card-name">@i.FirstName @i.LastName</p>
                        @if (!string.IsNullOrEmpty(i.Suburb))
                        {
                            <p class="instructor-card-location">@i.Suburb</p>
                        }
                        <div class="instructor-card-meta">
                            <span class="text-sm text-muted">@i.Experience yrs experience</span>
                        </div>
                    </div>
                </a>
            }
        </div>
        <div class="text-center" style="margin-top: 2rem;">
            <a href="/Instructors" class="btn">View All Instructors</a>
        </div>
    </div>
</section>
}

<!-- CTA Section -->
<section style="padding: 5rem 2rem; background: var(--fg); color: var(--primary-fg); text-align: center;">
    <h2 style="font-size: 2rem; font-weight: 700; letter-spacing: -0.03em;">Ready to Get Started?</h2>
    <p style="color: rgba(255,255,255,0.6); margin-top: 1rem; font-size: 1.125rem;">
        Join hundreds of students who are already on their journey to becoming confident drivers.
    </p>
    <div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/Account/Register" class="btn" style="background: white; color: var(--fg); border-color: white;">Sign Up Free</a>
        <a href="/Instructors" class="btn" style="border-color: rgba(255,255,255,0.3); color: white;">Browse Instructors</a>
    </div>
</section>
