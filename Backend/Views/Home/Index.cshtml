@{
    ViewData["Title"] = "Home";
    var userRole = Context.Session.GetString("UserRole");
}

<!-- HERO SECTION - Full viewport with background video -->
<section class="hero" style="min-height:100vh;position:relative;overflow:hidden;">
    <!-- Background Video -->
    <video class="hero-video-bg" autoplay muted loop playsinline poster="@Url.Content("~/images/bide-hero-fallback.jpg")">
        <source src="@Url.Content("~/videos/bide-hero.mp4")" type="video/mp4" />
    </video>
    <!-- Dark overlay for text readability -->
    <div style="position:absolute;inset:0;background:linear-gradient(to right, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0.3) 100%);z-index:1;"></div>
    <div class="hero-container" style="grid-template-columns:1fr 1fr;position:relative;z-index:2;">
        <div class="hero-content">
            <div class="hero-badge">
                #1 Driving Lesson Marketplace
            </div>
            <h1 class="hero-title">Learn to Drive<br/>with <span>Confidence</span></h1>
            <p class="hero-subtitle">
                Find trusted, verified driving instructors near you.
                Book lessons, track your progress and become
                a safe and confident driver.
            </p>
            <div class="hero-trust" style="margin-top:2rem;margin-bottom:2rem;">
                <div class="hero-trust-item">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    Verified Instructors
                </div>
                <div class="hero-trust-item">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>
                    Flexible Scheduling
                </div>
                <div class="hero-trust-item">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                    Secure Bookings
                </div>
            </div>
            <div class="hero-actions">
                @if (userRole == "Student")
                {
                    <a href="/Instructors" class="btn btn-primary btn-lg">Find an Instructor &rarr;</a>
                }
                else if (userRole == "Instructor")
                {
                    <a href="/InstructorDashboard" class="btn btn-primary btn-lg">Go to Dashboard &rarr;</a>
                }
                else if (userRole == "Admin")
                {
                    <a href="/Admin" class="btn btn-primary btn-lg">Admin Panel &rarr;</a>
                }
                else
                {
                    <a href="/Account/Login?redirect=instructors" class="btn btn-primary btn-lg">Find an Instructor &rarr;</a>
                    <a href="/Account/Register" class="btn btn-lg" style="border-color:rgba(255,255,255,0.4);color:white;background:transparent;">Become an Instructor &rarr;</a>
                }
            </div>
        </div>
        <div></div>
    </div>
</section>

<!-- WHY CHOOSE BiDE -->
<section class="section" style="background:white;">
    <div class="section-container">
        <div class="section-header text-center animate-on-scroll">
            <span class="section-label">Why Choose BiDE</span>
            <h2 class="section-title">Everything You Need to Start Driving</h2>
            <p class="section-subtitle">Our platform connects learners with verified instructors in a simple, secure process.</p>
        </div>
        <div class="grid-3" style="margin-top:3rem;">
            <div class="feature-card animate-on-scroll animate-delay-1">
                <div class="feature-icon">&#9989;</div>
                <h3 class="feature-title">Verified Instructors</h3>
                <p class="feature-desc">Every instructor is vetted and approved before they can offer lessons on our platform.</p>
            </div>
            <div class="feature-card animate-on-scroll animate-delay-2">
                <div class="feature-icon">&#128197;</div>
                <h3 class="feature-title">Flexible Scheduling</h3>
                <p class="feature-desc">Book lessons at times that work for you with real-time availability.</p>
            </div>
            <div class="feature-card animate-on-scroll animate-delay-3">
                <div class="feature-icon">&#128274;</div>
                <h3 class="feature-title">Secure Booking</h3>
                <p class="feature-desc">Upload proof of payment safely. Your instructor verifies before lessons begin.</p>
            </div>
            <div class="feature-card animate-on-scroll animate-delay-1">
                <div class="feature-icon">&#128200;</div>
                <h3 class="feature-title">Progress Tracking</h3>
                <p class="feature-desc">Detailed feedback after each session to track your improvement.</p>
            </div>
            <div class="feature-card animate-on-scroll animate-delay-2">
                <div class="feature-icon">&#11088;</div>
                <h3 class="feature-title">Honest Reviews</h3>
                <p class="feature-desc">Read genuine student reviews to choose the right instructor.</p>
            </div>
            <div class="feature-card animate-on-scroll animate-delay-3">
                <div class="feature-icon">&#128176;</div>
                <h3 class="feature-title">Affordable Lessons</h3>
                <p class="feature-desc">Compare prices and find instructors that fit your budget.</p>
            </div>
        </div>
    </div>
</section>

<!-- HOW IT WORKS - Removed, content will be in image1 -->

<!-- IMAGE 1 -->
<section class="section" style="background:white;">
    <div class="section-container">
        <div class="animate-on-scroll" style="width:100%;border-radius:var(--radius-xl);overflow:hidden;box-shadow:var(--shadow-lg);">
            <img src="@Url.Content("~/images/image1.png")" alt="Driving lessons" style="width:100%;height:auto;display:block;" loading="lazy" />
        </div>
    </div>
</section>

<!-- BECOME AN INSTRUCTOR CTA -->
<section class="section" style="background:var(--bg-muted);">
    <div class="section-container">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;" class="animate-on-scroll">
            <div>
                <span class="section-label">For Instructors</span>
                <h2 class="section-title" style="margin-top:0.75rem;">Become a BiDE Instructor</h2>
                <p style="margin-top:1rem;font-size:1rem;color:var(--fg-muted);line-height:1.8;">
                    Join our platform and connect with learners in your area. Manage your schedule, offer lessons,
                    verify payments and provide feedback — all in one place.
                </p>
                <ul style="margin-top:1.5rem;display:flex;flex-direction:column;gap:0.75rem;">
                    <li style="display:flex;align-items:center;gap:0.75rem;font-size:0.9375rem;color:var(--fg);">
                        <span style="color:var(--primary);font-size:1.25rem;">&#10004;</span> Set your own prices and schedule
                    </li>
                    <li style="display:flex;align-items:center;gap:0.75rem;font-size:0.9375rem;color:var(--fg);">
                        <span style="color:var(--primary);font-size:1.25rem;">&#10004;</span> Get verified and build trust
                    </li>
                    <li style="display:flex;align-items:center;gap:0.75rem;font-size:0.9375rem;color:var(--fg);">
                        <span style="color:var(--primary);font-size:1.25rem;">&#10004;</span> Manage bookings easily
                    </li>
                    <li style="display:flex;align-items:center;gap:0.75rem;font-size:0.9375rem;color:var(--fg);">
                        <span style="color:var(--primary);font-size:1.25rem;">&#10004;</span> Track student progress
                    </li>
                </ul>
                <a href="/Account/Register" class="btn btn-primary btn-lg" style="margin-top:2rem;">Join as Instructor &rarr;</a>
            </div>
            <!-- IMAGE 2 -->
            <div class="animate-on-scroll" style="border-radius:var(--radius-xl);overflow:hidden;box-shadow:var(--shadow-lg);">
                <img src="@Url.Content("~/images/image2.png")" alt="Become an instructor" style="width:100%;height:auto;display:block;" loading="lazy" />
            </div>
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="section" id="faq" style="background:white;">
    <div class="section-container" style="max-width:720px;">
        <div class="section-header text-center animate-on-scroll">
            <span class="section-label">FAQ</span>
            <h2 class="section-title">Frequently Asked Questions</h2>
        </div>
        <div style="margin-top:2rem;" class="animate-on-scroll">
            <div class="faq-item">
                <button class="faq-question" onclick="toggleFaq(this)">How do I book a driving lesson?<span class="faq-icon">+</span></button>
                <div class="faq-answer">Sign up as a student, browse instructors, select one you like, choose an available time slot and confirm your booking.</div>
            </div>
            <div class="faq-item">
                <button class="faq-question" onclick="toggleFaq(this)">How do payments work?<span class="faq-icon">+</span></button>
                <div class="faq-answer">Payments are handled externally via EFT or cash. After paying, upload your proof of payment through the platform. Your instructor will verify it before your lesson.</div>
            </div>
            <div class="faq-item">
                <button class="faq-question" onclick="toggleFaq(this)">Can I cancel a booking?<span class="faq-icon">+</span></button>
                <div class="faq-answer">Yes, you can cancel pending bookings from your bookings page. Simply click cancel and optionally provide a reason.</div>
            </div>
            <div class="faq-item">
                <button class="faq-question" onclick="toggleFaq(this)">How do I become an instructor?<span class="faq-icon">+</span></button>
                <div class="faq-answer">Register as an instructor, complete your profile with your experience and certification details. An administrator will review and approve your application.</div>
            </div>
            <div class="faq-item">
                <button class="faq-question" onclick="toggleFaq(this)">Is BiDE safe to use?<span class="faq-icon">+</span></button>
                <div class="faq-answer">Yes. All instructors are vetted and approved by administrators. We verify credentials before any instructor can appear on the platform.</div>
            </div>
        </div>
    </div>
</section>
