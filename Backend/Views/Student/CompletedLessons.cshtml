@model List<Booking>
@{
    ViewData["Title"] = "Completed Lessons";
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}

<div class="page-container">
    <div class="section-header">
        <p class="section-label">Student</p>
        <h1 class="section-title">Completed Lessons</h1>
    </div>

    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-info">@success</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-error">@error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p>No completed lessons yet</p>
        </div>
    }
    else
    {
        @foreach (var b in Model)
        {
            var hasReview = b.Review != null;
            var progressEntries = b.LessonProgresses?.ToList() ?? new List<LessonProgress>();

            <div class="card">
                <div class="card-row">
                    <div>
                        <p class="card-title">@(b.LessonOffering?.Title ?? "Lesson")</p>
                        <p class="card-subtitle">@b.Instructor?.FirstName @b.Instructor?.LastName</p>
                        <div class="card-meta">
                            <span class="card-meta-item">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                @(b.Schedule?.Date.ToString("MMM d, yyyy") ?? "")
                            </span>
                            <span class="card-meta-item">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                @(b.Schedule?.StartTime.ToString(@"hh\:mm") ?? "") - @(b.Schedule?.EndTime.ToString(@"hh\:mm") ?? "")
                            </span>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        @if (progressEntries.Count > 0)
                        {
                            <button type="button" class="btn btn-ghost btn-sm"
                                    onclick="toggleExpand('progress-@b.BookingId')">
                                Progress (@progressEntries.Count)
                            </button>
                        }
                        @if (hasReview)
                        {
                            <span class="badge badge-completed">
                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                Reviewed
                            </span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm"
                                    onclick="openReviewModal(@b.BookingId, '@(b.LessonOffering?.Title ?? "Lesson")')">
                                Leave Review
                            </button>
                        }
                    </div>
                </div>


                <!-- Progress Section (expandable) -->
                @if (progressEntries.Count > 0)
                {
                    <div id="progress-@b.BookingId" class="progress-section hidden">
                        <p class="detail-section-title" style="margin-bottom: 0.5rem;">Instructor Feedback</p>
                        @foreach (var e in progressEntries)
                        {
                            <div class="progress-entry">
                                <div class="progress-header">
                                    <span class="progress-date">@e.ProgressDate.ToString("MMM d, yyyy")</span>
                                    <span class="progress-rating">@e.CompletionStatus</span>
                                </div>
                                @if (!string.IsNullOrEmpty(e.Feedback))
                                {
                                    <p style="margin-top: 0.25rem;">@e.Feedback</p>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Leave Review Modal -->
<div class="modal-overlay" id="reviewModal">
    <div class="modal" style="position: relative;">
        <button class="modal-close" onclick="closeModal('reviewModal')">&times;</button>
        <h3 class="modal-title">Leave a Review</h3>

        <div style="padding: 0.75rem; background: var(--bg-muted); margin-bottom: 1rem; font-size: 0.875rem;">
            <p class="font-bold" id="review-lesson-title"></p>
        </div>

        <form method="post" asp-action="LeaveReview" asp-controller="Student">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bookingId" id="review-booking-id" value="" />

            <div class="form-group">
                <label class="form-label">Rating *</label>
                <select name="rating" class="form-select" required>
                    <option value="">-- Select --</option>
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Very Good</option>
                    <option value="3">3 - Good</option>
                    <option value="2">2 - Fair</option>
                    <option value="1">1 - Poor</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Comment (optional)</label>
                <textarea name="comment" class="form-textarea" rows="3"
                          placeholder="Share your experience..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-full">Submit Review</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
function openReviewModal(bookingId, title) {
    document.getElementById('review-booking-id').value = bookingId;
    document.getElementById('review-lesson-title').textContent = title;
    openModal('reviewModal');
}
</script>
}
