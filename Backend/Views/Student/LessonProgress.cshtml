@model List<Booking>
@{
    ViewData["Title"] = "Lesson Progress";
}

<div class="page-container">
    <div class="section-header">
        <p class="section-label">Student</p>
        <h1 class="section-title">Lesson Progress</h1>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state" style="padding: 4rem;">
            <p class="text-muted">No lesson progress to show yet. Progress will appear here once your instructor records feedback.</p>
        </div>
    }
    else
    {
        @foreach (var b in Model)
        {
            var entries = b.LessonProgresses?.ToList() ?? new List<LessonProgress>();

            <div class="card" style="margin-bottom: 1.5rem;">
                <div class="card-row">
                    <div>
                        <p class="card-title">@(b.LessonOffering?.Title ?? "Lesson")</p>
                        <p class="card-subtitle">Instructor: @b.Instructor?.FirstName @b.Instructor?.LastName</p>
                        <div class="card-meta">
                            <span class="card-meta-item">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                @(b.Schedule?.Date.ToString("MMM d, yyyy") ?? "")
                            </span>
                            <span class="card-meta-item">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                @(b.Schedule?.StartTime.ToString(@"hh\:mm") ?? "") - @(b.Schedule?.EndTime.ToString(@"hh\:mm") ?? "")
                            </span>
                            <span class="badge badge-@b.Status.ToLower()">@b.Status</span>
                        </div>
                    </div>
                </div>

                @if (entries.Count > 0)
                {
                    <div class="progress-section" style="margin-top: 1rem;">
                        <p class="detail-section-title" style="margin-bottom: 0.5rem;">Instructor Feedback</p>
                        @foreach (var e in entries)
                        {
                            <div class="progress-entry">
                                <div class="progress-header">
                                    <span class="progress-date">@e.ProgressDate.ToString("MMM d, yyyy")</span>
                                    <span class="progress-rating">Rating: @e.CompletionStatus</span>
                                </div>
                                @if (!string.IsNullOrEmpty(e.Feedback))
                                {
                                    <p style="margin-top: 0.25rem;">@e.Feedback</p>
                                }
                                @if (e.Duration > 0)
                                {
                                    <p class="text-xs text-muted mt-1">Duration: @e.Duration min</p>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-sm" style="margin-top: 0.75rem;">No progress recorded yet for this lesson.</p>
                }
            </div>
        }
    }
</div>
