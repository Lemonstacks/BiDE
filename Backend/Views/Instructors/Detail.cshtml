@model Instructor
@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";
    var offerings = ViewBag.Offerings as List<LessonOffering> ?? new List<LessonOffering>();
    var availability = ViewBag.Availability as List<Availability> ?? new List<Availability>();
    var reviews = ViewBag.Reviews as List<Review> ?? new List<Review>();
    var avgRating = reviews.Count > 0 ? reviews.Average(r => r.Rating) : 0;
}

<div class="page-container">
    <a href="/Instructors" class="btn btn-ghost btn-sm" style="margin-bottom:2rem;">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Instructors
    </a>

    <div class="detail-grid">
        <!-- Left Column -->
        <div>
            <div class="detail-img">
                @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                {
                    <img src="@Model.ProfilePicture" alt="@Model.FirstName @Model.LastName" />
                }
                else
                {
                    @Model.FirstName[0]@Model.LastName[0]
                }
            </div>

            <h1 class="detail-name">@Model.FirstName @Model.LastName</h1>

            @if (reviews.Count > 0)
            {
                <div style="display:flex;align-items:center;gap:0.5rem;margin-top:0.75rem;">
                    <span style="color:var(--warning);font-size:1.125rem;">&#9733;</span>
                    <span style="font-weight:700;">@avgRating.ToString("0.0")</span>
                    <span class="text-muted text-sm">(@reviews.Count review@(reviews.Count > 1 ? "s" : ""))</span>
                </div>
            }

            <div class="detail-info">
                @if (!string.IsNullOrEmpty(Model.Suburb))
                {
                    <span class="detail-info-item">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        @Model.Suburb
                    </span>
                }
                @if (Model.Experience > 0)
                {
                    <span class="detail-info-item">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        @Model.Experience years experience
                    </span>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Certification))
            {
                <div style="margin-top:1rem;">
                    <span class="badge badge-approved" style="font-size:0.8125rem;padding:0.5rem 1rem;">
                        &#127942; @Model.Certification
                    </span>
                </div>
            }

            <div class="detail-info" style="margin-top:1rem;">
                <span class="detail-info-item">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                    @Model.Contact
                </span>
            </div>
        </div>

        <!-- Right Column -->
        <div>
            <!-- Offerings -->
            <div style="margin-bottom:3rem;">
                <p class="detail-section-title">Lesson Offerings</p>
                <hr class="detail-divider" />
                @if (offerings.Count == 0)
                {
                    <p class="text-sm text-muted">No offerings available yet.</p>
                }
                else
                {
                    @foreach (var o in offerings)
                    {
                        <div class="offering-row">
                            <div>
                                <p class="offering-title">@o.Title</p>
                                <div class="offering-meta">
                                    <span>@o.LessonType</span>
                                    @if (!string.IsNullOrEmpty(o.Description))
                                    { <span>@o.Description</span> }
                                </div>
                            </div>
                            <div style="text-align:right;flex-shrink:0;">
                                <p class="offering-price">R@(o.Price.ToString("N0"))</p>
                                <button type="button" class="btn btn-primary btn-sm" style="margin-top:0.5rem;"
                                        onclick="openBookingModal(@o.OfferId, '@o.Title', '@(o.Price.ToString("N0"))')">
                                    Book Now &rarr;
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Schedule -->
            <div style="margin-bottom:3rem;">
                <p class="detail-section-title">Available Slots</p>
                <hr class="detail-divider" />
                @if (availability.Count == 0)
                {
                    <p class="text-sm text-muted">No schedule set yet.</p>
                }
                else
                {
                    <div class="schedule-grid">
                        @foreach (var a in availability)
                        {
                            <div class="schedule-slot">
                                <p class="schedule-day">@a.Date.ToString("ddd, MMM d")</p>
                                <p class="schedule-time">@a.StartTime.ToString(@"hh\:mm") - @a.EndTime.ToString(@"hh\:mm")</p>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Reviews -->
            <div>
                <p class="detail-section-title">Reviews (@reviews.Count)</p>
                <hr class="detail-divider" />
                @if (reviews.Count == 0)
                {
                    <p class="text-sm text-muted">No reviews yet.</p>
                }
                else
                {
                    @foreach (var r in reviews)
                    {
                        <div class="review-card">
                            <div class="review-header">
                                <div>
                                    <p class="review-author">@r.Student.FirstName @r.Student.LastName</p>
                                    <p class="review-date">@r.ReviewDate.ToString("MMM d, yyyy")</p>
                                </div>
                                <div class="review-stars">
                                    @for (int star = 1; star <= 5; star++)
                                    {
                                        if (star <= r.Rating) { <span class="review-star">&#9733;</span> }
                                        else { <span class="review-star-empty">&#9733;</span> }
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(r.Comment))
                            { <p class="review-text">@r.Comment</p> }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Booking Modal -->
<div class="modal-overlay" id="bookingModal">
    <div class="modal" style="position:relative;">
        <button class="modal-close" onclick="closeModal('bookingModal')">&times;</button>
        <h3 class="modal-title">Book a Lesson</h3>
        <div style="padding:1rem;background:var(--bg-muted);border-radius:var(--radius);margin-bottom:1.25rem;">
            <p class="font-bold" id="modal-offering-title"></p>
            <p class="text-muted text-sm" style="margin-top:0.25rem;">with @Model.FirstName @Model.LastName</p>
        </div>
        <form method="post" asp-action="Book" asp-controller="Instructors">
            @Html.AntiForgeryToken()
            <input type="hidden" name="instructorId" value="@Model.InstructorId" />
            <input type="hidden" name="offerId" id="modal-offer-id" value="" />
            <div class="form-group">
                <label class="form-label">Select Available Slot *</label>
                <select name="scheduleId" class="form-select" required>
                    <option value="">-- Choose a time slot --</option>
                    @foreach (var a in availability)
                    {
                        <option value="@a.AvailabilityId">@a.Date.ToString("ddd, MMM d") | @a.StartTime.ToString(@"hh\:mm") - @a.EndTime.ToString(@"hh\:mm")</option>
                    }
                </select>
            </div>
            @if (availability.Count == 0)
            { <div class="alert alert-warning">No available time slots. Check back later.</div> }
            else
            { <button type="submit" class="btn btn-primary btn-full btn-lg">Confirm Booking</button> }
        </form>
    </div>
</div>

@section Scripts {
<script>
function openBookingModal(offerId, title, price) {
    document.getElementById('modal-offering-title').textContent = title + ' \u2014 R' + price;
    document.getElementById('modal-offer-id').value = offerId;
    openModal('bookingModal');
}
</script>
}
