@model List<Instructor>
@{
    ViewData["Title"] = "Find Instructors";
    var search = ViewBag.Search as string ?? "";
    var specialization = ViewBag.Specialization as string ?? "all";
    var certifications = ViewBag.Certifications as List<string> ?? new List<string>();
}

<div class="page-container">
    <div class="section-header">
        <p class="section-label">Search</p>
        <h1 class="section-title">Find Your Instructor</h1>
    </div>

    <!-- Search & Filter -->
    <form method="get" class="search-bar">
        <div class="search-input-wrap">
            <svg class="search-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <input type="text" name="search" value="@search"
                   class="form-input" placeholder="Search by name or location..." />
        </div>
        <select name="specialization" class="form-select search-select">
            <option value="all">All Types</option>
            @foreach (var cert in certifications)
            {
                <option value="@cert" selected="@(specialization == cert)">@cert</option>
            }
        </select>
        <button type="submit" class="btn btn-primary btn-sm">Search</button>
    </form>

    <!-- Results -->
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p>No instructors found</p>
            <p class="sub">Try adjusting your search criteria</p>
        </div>
    }
    else
    {
        <div class="grid-3" style="margin-top: 2rem;">
            @foreach (var i in Model)
            {
                <a href="/Instructors/Detail/@i.InstructorId" class="instructor-card">
                    <div class="instructor-card-img">
                        @i.FirstName[0]@i.LastName[0]
                    </div>
                    <div class="instructor-card-body">
                        <p class="instructor-card-name">@i.FirstName @i.LastName</p>
                        @if (!string.IsNullOrEmpty(i.Suburb))
                        {
                            <p class="instructor-card-location">@i.Suburb</p>
                        }
                        <div class="instructor-card-meta">
                            <span class="text-sm text-muted">@i.Experience yrs exp</span>
                            @if (!string.IsNullOrEmpty(i.Certification))
                            {
                                <span class="text-sm text-muted">@i.Certification</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
