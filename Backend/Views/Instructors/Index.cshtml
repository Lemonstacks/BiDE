@model List<Instructor>
@{
    ViewData["Title"] = "Find Instructors";
    var search = ViewBag.Search as string ?? "";
    var filterBy = ViewBag.FilterBy as string ?? "all";
    var sortByLocation = filterBy == "location";
    var lessonType = ViewBag.LessonType as string ?? "all";
    var hasTypeFilter = lessonType != "all";
    var lessonTypes = new[] { "Manual", "Automatic", "Highway", "Parking", "Defensive", "Refresher" };
}

<div class="page-header-bg bg-find-instructor">
    <div class="section-header">
        <span class="section-label">Search</span>
        <h1 class="section-title">Find Your Instructor</h1>
        <p class="section-subtitle">Browse verified driving instructors by name, location or specialization.</p>
    </div>
</div>

<div class="page-container" style="padding-top:3rem;">

    <!-- Search -->
    <form method="get" class="search-bar" style="margin-top:2rem;">
        <div class="search-input-wrap">
            <svg class="search-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <input type="text" name="search" value="@search" class="form-input" placeholder="Search by name, suburb, certification or lesson type..." />
        </div>
        <label for="filter-lesson-type" class="form-label" style="margin-bottom:0;align-self:center;">Lesson type</label>
        <select id="filter-lesson-type" name="lessonType" class="form-select search-select" onchange="this.form.submit()">
            <option value="all" selected="@(!hasTypeFilter)">All types</option>
            @foreach (var t in lessonTypes)
            {
                <option value="@t" selected="@(lessonType == t)">@t</option>
            }
        </select>
        <label for="sort-instructors" class="form-label" style="margin-bottom:0;align-self:center;">Sort</label>
        <select id="sort-instructors" name="filterBy" class="form-select search-select" onchange="this.form.submit()">
            <option value="experience" selected="@(!sortByLocation)">Sort: Most experienced</option>
            <option value="location" selected="@sortByLocation">Sort: Location A-Z</option>
        </select>
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <!-- Results -->
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            @if (!string.IsNullOrWhiteSpace(search) || hasTypeFilter)
            {
                if (!string.IsNullOrWhiteSpace(search))
                {
                    <p>No instructors match "@search"@(hasTypeFilter ? $" for {lessonType} lessons" : "")</p>
                }
                else
                {
                    <p>No instructors offer @lessonType lessons</p>
                }
                <p class="sub">Try a different name, suburb, certification or lesson type.</p>
                <a href="/Instructors" class="btn btn-primary" style="margin-top:1.25rem;">Clear search</a>
            }
            else
            {
                <p>No instructors available yet</p>
                <p class="sub">Check back soon as more verified instructors join.</p>
            }
        </div>
    }
    else
    {
        <div class="instructor-grid" style="margin-top:2.5rem;">
            @foreach (var i in Model)
            {
                <a href="/Instructors/Detail/@i.InstructorId" class="instructor-card animate-on-scroll">
                    <div class="instructor-card-img">
                        @if (!string.IsNullOrEmpty(i.ProfilePicture))
                        { <img src="@i.ProfilePicture" alt="@i.FirstName @i.LastName" loading="lazy" /> }
                        else
                        { @i.FirstName[0]@i.LastName[0] }
                    </div>
                    <div class="instructor-card-body">
                        <p class="instructor-card-name">@i.FirstName @i.LastName</p>
                        @if (!string.IsNullOrEmpty(i.Suburb))
                        { <p class="instructor-card-location">&#128205; @i.Suburb</p> }
                        <div class="instructor-card-meta">
                            <span>@i.Experience yrs exp</span>
                            @if (!string.IsNullOrEmpty(i.Certification))
                            { <span>@i.Certification</span> }
                        </div>
                        <p style="margin-top:1rem;font-size:0.8125rem;font-weight:600;color:var(--primary);">View Profile &rarr;</p>
                    </div>
                </a>
            }
        </div>
    }
</div>
