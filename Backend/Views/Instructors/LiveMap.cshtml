@{
    ViewData["Title"] = "Live Map";
}

<div class="page-container">
    <div class="section-header">
        <p class="section-label">Student</p>
        <h1 class="section-title">Find Instructors Near You</h1>
        <p class="text-sm text-muted" style="margin-top: 0.5rem;">Available instructors appear on the map in real time. Click a name to locate them on the map.</p>
    </div>

    <div class="livemap-grid">
        <!-- Map (3/4) -->
        <div id="live-map" style="border-radius: 12px; overflow: hidden; border: 1px solid var(--border); min-height: 400px;"></div>

        <!-- Sidebar (1/4) -->
        <div style="background: var(--bg-card, #1a1a2e); border: 1px solid var(--border); border-radius: 12px; overflow-y: auto; padding: 1rem;">
            <p style="font-weight: 600; font-size: 0.875rem; margin-bottom: 0.75rem; opacity: 0.7; text-transform: uppercase; letter-spacing: 0.05em;">Available Now</p>
            <div id="instructor-list">
                <p class="text-sm text-muted" id="list-empty">Waiting for instructors to go live...</p>
            </div>
        </div>
    </div>

    <div id="map-status" class="alert alert-info" style="margin-top: 1rem; display: none;"></div>

    <form id="antiforgery-form" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</div>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<!-- SignalR JS Client -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

@section Scripts {
<script src="~/js/livemap.js"></script>
}
