@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Live Map";
    var mapboxToken = Configuration["Mapbox:Token"];
}

<div class="market-shell">
    <!-- Heading -->
    <div class="page-heading">
        <div>
            <p class="eyebrow">LIVE AVAILABILITY</p>
            <h1>
                Instructors near you
                <span class="live-badge"><i></i><span id="available-count">0</span> live now</span>
            </h1>
            <p>Ready when you are. Book a lesson and start driving today.</p>
        </div>
        <div class="filters" id="transmission-filters">
            <button type="button" class="active" data-filter="all">All instructors</button>
            <button type="button" data-filter="Automatic">Automatic</button>
            <button type="button" data-filter="Manual">Manual</button>
        </div>
    </div>

    <!-- Map + Sidebar -->
    <div class="market-grid">
        <!-- Map -->
        <div class="map-wrap">
            <div id="live-map" style="width:100%; height:100%;"></div>
            <div class="map-chip">
                <span id="map-area">Your area</span>
                <span class="live-badge compact"><i></i><span id="chip-count">0</span> live now</span>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="sidebar">
            <div class="side-heading">
                <div>
                    <strong>Available now</strong>
                    <span>Updated moments ago</span>
                </div>
                <span id="side-count">0</span>
            </div>
            <div class="cards" id="instructor-list">
                <div id="list-loading" class="side-skeletons">
                    @for (int s = 0; s < 3; s++)
                    {
                        <div class="skeleton-card" style="background:rgba(255,255,255,.045);border-color:rgba(255,255,255,.08);">
                            <div class="skeleton-row">
                                <div class="skeleton skeleton-avatar square" style="width:50px;height:55px;"></div>
                                <div style="flex:1;">
                                    <div class="skeleton skeleton-text w-50"></div>
                                    <div class="skeleton skeleton-text w-25"></div>
                                    <div class="skeleton skeleton-text w-75" style="margin-bottom:0;"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <p id="list-empty" class="text-sm" style="color:#848d9d; padding:1rem 0; display:none;">Waiting for instructors to go live...</p>
            </div>
            <div class="trust-note">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>
                    <strong>Every instructor is verified</strong>
                    DVSA approved, insured and background checked.
                </span>
            </div>
        </div>
    </div>

    <div id="map-status" class="alert alert-info" style="margin-top: 1rem; display: none;"></div>

    <form id="antiforgery-form" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</div>

<!-- Mapbox GL JS -->
<link href="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.css" rel="stylesheet" />
<script src="https://api.mapbox.com/mapbox-gl-js/v3.9.0/mapbox-gl.js"></script>

<!-- SignalR JS Client -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

@section Scripts {
<script>
    window.MAPBOX_TOKEN = "@mapboxToken";
</script>
<script src="~/js/livemap.js" asp-append-version="true"></script>
}
