<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BiDE</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"></noscript>

    <!-- PWA (installable app) -->
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="BiDE" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
</head>
<body>
    <!-- Navigation -->
    @{
        var isLoggedIn = Context.Session.GetInt32("UserId") != null;
        var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
        var isLandingPage = currentPath == "/" || currentPath == "/home" || currentPath == "/home/index" || currentPath == "/instructors" || currentPath == "/instructors/index";
        var navClass = (isLoggedIn && !isLandingPage) ? "navbar navbar-sticky" : "navbar";

        // Returns "active" when the current path starts with the given prefix
        Func<string, string> navActive = (prefix) =>
            currentPath.Equals(prefix, StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase)
                ? "active" : "";
    }
    <nav class="@navClass">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">
                <img src="@Url.Content("~/images/logo-full.png")" alt="BiDE" style="height:48px;width:auto;" />
            </a>

            <!-- Typing Animation (only shows when not logged in) -->
            @if (!isLoggedIn)
            {
                <div class="navbar-typing">
                    <span id="typingText"></span><span class="typing-cursor">|</span>
                </div>
            }

            <!-- Desktop Nav (hidden on mobile) -->
            <div class="navbar-desktop">
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    var desktopRole = Context.Session.GetString("UserRole");
                    @if (desktopRole == "Student")
                    {
                        var onLiveMap = currentPath.StartsWith("/instructors/livemap");
                        var onInstructors = currentPath.StartsWith("/instructors") && !onLiveMap;
                        <a href="/Instructors" class="nav-link @(onInstructors ? "active" : "")">Instructors</a>
                        <a href="/Instructors/LiveMap" class="nav-link @(onLiveMap ? "active" : "")">Live Map</a>
                        <a href="/Student/Bookings" class="nav-link @navActive("/student/bookings")">Bookings</a>
                        <a href="/Student/LessonProgress" class="nav-link @navActive("/student/lessonprogress")">Progress</a>
                        <a href="/Profile" class="nav-link @navActive("/profile")">Profile</a>
                        <a href="/Account/Logout" class="nav-link nav-link-cta">Logout</a>
                    }
                    @if (desktopRole == "Instructor")
                    {
                        var onDash = currentPath == "/instructordashboard" || currentPath == "/instructordashboard/index";
                        <a href="/InstructorDashboard" class="nav-link @(onDash ? "active" : "")">Dashboard</a>
                        <a href="/InstructorDashboard/Offerings" class="nav-link @navActive("/instructordashboard/offerings")">Offerings</a>
                        <a href="/InstructorDashboard/Availability" class="nav-link @navActive("/instructordashboard/availability")">Availability</a>
                        <a href="/InstructorDashboard/Payments" class="nav-link @navActive("/instructordashboard/payments")">Payments</a>
                        <a href="/Profile" class="nav-link @navActive("/profile")">Profile</a>
                        <a href="/Account/Logout" class="nav-link nav-link-cta">Logout</a>
                    }
                    @if (desktopRole == "Admin")
                    {
                        var onAdminHome = currentPath == "/admin" || currentPath == "/admin/index";
                        <a href="/Admin" class="nav-link @(onAdminHome ? "active" : "")">Applications</a>
                        <a href="/Admin/ManageUsers" class="nav-link @navActive("/admin/manageusers")">Users</a>
                        <a href="/Admin/MonitorBookings" class="nav-link @navActive("/admin/monitorbookings")">Bookings</a>
                        <a href="/Admin/ViewPayments" class="nav-link @navActive("/admin/viewpayments")">Payments</a>
                        <a href="/Account/Logout" class="nav-link nav-link-cta">Logout</a>
                    }
                }
                else
                {
                    <a href="/Account/Login" class="nav-link">Login</a>
                    <a href="/Account/Register" class="nav-link nav-link-primary">Sign Up</a>
                }
            </div>

            <!-- Hamburger toggle (visible on mobile only) -->
            <button class="navbar-toggle" onclick="toggleHamburgerMenu()" aria-label="Open menu">
                <span></span><span></span><span></span>
            </button>
        </div>
        <div class="hamburger-menu-overlay" id="hamburgerMenuOverlay" onclick="closeHamburgerIfOverlay(event)">
            <div class="hamburger-menu">
                <div class="hamburger-menu-header">
                    <span class="hamburger-menu-brand">BiDE</span>
                    <button class="hamburger-menu-close" onclick="closeHamburgerMenu()" aria-label="Close menu">&times;</button>
                </div>
                <div class="hamburger-menu-body">
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        var role = Context.Session.GetString("UserRole");
                        var userName = Context.Session.GetString("UserName") ?? "User";
                        <div class="hamburger-menu-user">
                            <p class="hamburger-menu-user-name">@userName</p>
                            <p class="hamburger-menu-user-role">@role</p>
                        </div>
                        @if (role == "Student")
                        {
                            <div class="hamburger-menu-section">
                                <p class="hamburger-menu-section-label">Navigation</p>
                                <a href="/Instructors" class="hamburger-menu-link">Find Instructors</a>
                                <a href="/Instructors/LiveMap" class="hamburger-menu-link">Live Map</a>
                                <a href="/Student/Bookings" class="hamburger-menu-link">My Bookings</a>
                                <a href="/Student/LessonProgress" class="hamburger-menu-link">View Lesson Progress</a>
                                <a href="/Student/CompletedLessons" class="hamburger-menu-link">Completed Lessons</a>
                            </div>
                            <div class="hamburger-menu-section">
                                <p class="hamburger-menu-section-label">Account</p>
                                <a href="/Profile" class="hamburger-menu-link">Edit Profile</a>
                                <a href="/Account/Logout" class="hamburger-menu-link hamburger-menu-link-muted">Logout</a>
                            </div>
                        }
                        @if (role == "Instructor")
                        {
                            <div class="hamburger-menu-section">
                                <p class="hamburger-menu-section-label">Navigation</p>
                                <a href="/InstructorDashboard" class="hamburger-menu-link">Dashboard</a>
                                <a href="/InstructorDashboard/Offerings" class="hamburger-menu-link">Lesson Offerings</a>
                                <a href="/InstructorDashboard/Availability" class="hamburger-menu-link">Manage Availability</a>
                                <a href="/InstructorDashboard/Index#booking-requests" class="hamburger-menu-link">Booking Requests</a>
                                <a href="/InstructorDashboard/Payments" class="hamburger-menu-link">Verify Payment</a>
                                <a href="/InstructorDashboard/LessonProgress" class="hamburger-menu-link">Lesson Progress</a>
                                <a href="/InstructorDashboard/GoLive" class="hamburger-menu-link">Go Live</a>
                            </div>
                            <div class="hamburger-menu-section">
                                <p class="hamburger-menu-section-label">Account</p>
                                <a href="/Profile" class="hamburger-menu-link">Edit Profile</a>
                                <a href="/Account/Logout" class="hamburger-menu-link hamburger-menu-link-muted">Logout</a>
                            </div>
                        }
                        @if (role == "Admin")
                        {
                            <div class="hamburger-menu-section">
                                <p class="hamburger-menu-section-label">Administration</p>
                                <a href="/Admin" class="hamburger-menu-link">Instructor Applications</a>
                                <a href="/Admin/ManageUsers" class="hamburger-menu-link">Manage Users</a>
                                <a href="/Admin/MonitorBookings" class="hamburger-menu-link">Monitor Bookings</a>
                                <a href="/Admin/ViewPayments" class="hamburger-menu-link">View Payments</a>
                            </div>
                            <div class="hamburger-menu-section">
                                <p class="hamburger-menu-section-label">Account</p>
                                <a href="/Profile" class="hamburger-menu-link">Edit Profile</a>
                                <a href="/Account/Logout" class="hamburger-menu-link hamburger-menu-link-muted">Logout</a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="hamburger-menu-section">
                            <p class="hamburger-menu-section-label">Get Started</p>
                            <a href="/Account/Login" class="hamburger-menu-link">Login</a>
                            <a href="/Account/Register" class="hamburger-menu-link">Sign Up</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div id="toast-container" class="toast-container"></div>
    <main>@RenderBody()</main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-grid">
                <div>
                    <h3 class="footer-brand">BiDE</h3>
                    <p class="footer-text">The premium driving lesson marketplace connecting learners with verified instructors.</p>
                </div>
                <div>
                    <h4 class="footer-heading">Students</h4>
                    <a href="/Instructors" class="footer-link">Find Instructors</a>
                    @{
                        var footerIsStudent = Context.Session.GetInt32("UserId") != null
                            && Context.Session.GetString("UserRole") == "Student";
                    }
                    @if (footerIsStudent)
                    {
                        <a href="/Student/Bookings" class="footer-link">My Bookings</a>
                        <a href="/Student/LessonProgress" class="footer-link">Progress</a>
                    }
                </div>
                <div>
                    <h4 class="footer-heading">Instructors</h4>
                    <a href="/Account/Register" class="footer-link">Become Instructor</a>
                    <a href="/InstructorDashboard" class="footer-link">Dashboard</a>
                </div>
                <div>
                    <h4 class="footer-heading">Support</h4>
                    @* TODO: replace href="#" with real Help Centre / Contact targets when those pages exist *@
                    <a href="#" class="footer-link">Help Centre</a>
                    <a href="#" class="footer-link">Contact</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year BiDE. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Chat Widget -->
    <div class="chat-widget">
        <button class="chat-widget-toggle" onclick="toggleChatWidget()" aria-label="Chat">
            <svg id="chatIconOpen" aria-hidden="true" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            <svg id="chatIconClose" aria-hidden="true" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display:none;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="chat-widget-panel" id="chatPanel">
            <div class="chat-widget-header">
                <div><p class="chat-widget-header-title">BiDE Assistant</p><p class="chat-widget-header-subtitle">How can I help?</p></div>
                <button class="chat-widget-header-close" onclick="toggleChatWidget()" aria-label="Close chat">&times;</button>
            </div>
            <div class="chat-widget-messages" id="chatMessages">
                <div class="chat-msg chat-msg-bot"><p>Hi! Ask me about booking, payments, reviews, or anything else.</p></div>
            </div>
            <div class="chat-widget-input">
                <input type="text" id="chatInput" placeholder="Type a message..." onkeypress="if(event.key==='Enter') sendChatMessage();" />
                <button onclick="sendChatMessage()" aria-label="Send message"><svg aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></button>
            </div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Register PWA Service Worker -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/service-worker.js').catch(function () { /* ignore */ });
            });
        }
    </script>
</body>
</html>
